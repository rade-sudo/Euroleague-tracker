# Glavni .htaccess za poddomen (Vite ga kopira u dist/ pri buildu).
RewriteEngine On

# Uvijek HTTPS: kolačić za prijavu se tada šalje samo preko sigurne veze.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# API ima svoj .htaccess u folderu api/.
RewriteRule ^api(/|$) - [L]

# Postojeći fajlovi (JS, CSS, slike) idu direktno, a sve ostalo (npr. /prijava) na aplikaciju.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]

AddType application/manifest+json .webmanifest

# index.html, service worker i manifest se ne keširaju, da svi odmah dobiju novu verziju poslije postavljanja.
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest|offline\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
